# Public credentials for this loopback-only manual lab, not deployment secrets.
# Source in each terminal: . sandbox/Java/local.env
export YUBARTA_JAVA_SSH_PORT="${YUBARTA_JAVA_SSH_PORT:-2222}"
export YUBARTA_JAVA_HTTP_PORT="${YUBARTA_JAVA_HTTP_PORT:-18080}"
export YUBARTA_JAVA_DB_PORT="${YUBARTA_JAVA_DB_PORT:-5433}"
export YUBARTA_JAVA_API_PORT="${YUBARTA_JAVA_API_PORT:-8787}"
export YUBARTA_JAVA_SSH_PASSWORD=yubarta
export YUBARTA_SERVER_URL="http://127.0.0.1:${YUBARTA_JAVA_API_PORT}"
