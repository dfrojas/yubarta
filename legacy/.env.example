# Copy to .env for local development. Hostnames are compose service names, so this
# file only makes sense from inside the rig.
APP_ENV=dev

# Path to the target inventory, relative to the working directory.
INVENTORY_PATH=inventory.yaml

DB_USER=yubarta
DB_PASSWORD=password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=yubarta
# Log every SQL statement. Useful when debugging the incident store, noisy otherwise.
DB_ECHO=false

# Nothing consumes Kafka yet (the Director is stage 4), these are the defaults it
# will start from.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ALERT_TOPIC=alerts
KAFKA_CONSUMER_GROUP=alert_processor
